rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 'X' or 'O': which seat the signed-in user holds in this room
    function mySeat(room) {
      return request.auth.uid == room.players.X.uid ? 'X' : 'O';
    }

    // A room is a game between two signed-in players. `uids` lists who is in it.
    // A room starts with no game (game == null) and the players choose one inside it.
    // Turn games (ttt, memory, photo) alternate moves. Race games (sudoku, slide) let both players solve at once.
    match /rooms/{code} {
      allow get: if request.auth != null;                         // anyone signed in can look a room up by its code
      allow list: if request.auth != null && request.auth.uid in resource.data.uids;  // but can only list their own

      allow create: if request.auth != null
        && request.resource.data.uids == [request.auth.uid]
        && request.resource.data.players.X.uid == request.auth.uid
        && request.resource.data.players.O == null
        && request.resource.data.game == null;   // the players pick a game inside the room

      allow update: if request.auth != null && (
        // join: take the empty O seat, nothing else changes
        (resource.data.uids.size() == 1
          && !(request.auth.uid in resource.data.uids)
          && request.resource.data.uids == resource.data.uids.concat([request.auth.uid])
          && request.resource.data.players.X == resource.data.players.X
          && request.resource.data.players.O.uid == request.auth.uid
          && request.resource.data.game == resource.data.game)
        ||
        // send, cancel or decline an invite to a game: nothing but the invite changes, so the other player
        // keeps playing whatever they are playing until they accept
        (request.auth.uid in resource.data.uids
          && resource.data.uids.size() == 2
          && request.resource.data.uids == resource.data.uids
          && request.resource.data.players == resource.data.players
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invite'])
          && (request.resource.data.invite == null
              || (request.resource.data.invite.by.uid == request.auth.uid
                  && request.resource.data.invite.game in ['ttt', 'photo', 'memory', 'sudoku', 'slide'])))
        ||
        // accept the OTHER player's invite: this is the only way a game starts or is switched, so nobody can
        // force a game on the other. Only the game and its fresh state change, never the seats or the score.
        (request.auth.uid in resource.data.uids
          && resource.data.uids.size() == 2
          && request.resource.data.uids == resource.data.uids
          && request.resource.data.players == resource.data.players
          && request.resource.data.code == resource.data.code
          && resource.data.invite != null
          && resource.data.invite.by.uid != request.auth.uid
          && request.resource.data.game == resource.data.invite.game
          && (request.resource.data.game != resource.data.game   // switching games, or the same game at a new level
              || request.resource.data.round == resource.data.round + 1)
          && request.resource.data.invite == null
          && request.resource.data.over == false
          && request.resource.data.winner == null
          && request.resource.data.startedBy.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['game', 'invite', 'startedBy', 'state', 'round', 'turn', 'starter', 'over', 'winner', 'progX', 'progO']))
        ||
        // inside a full room with a game running: who is in it, and which game, never change
        (request.auth.uid in resource.data.uids
          && resource.data.uids.size() == 2
          && request.resource.data.uids == resource.data.uids
          && request.resource.data.players == resource.data.players
          && request.resource.data.game == resource.data.game
          && request.resource.data.code == resource.data.code
          && (
            // rematch after the game ended
            (resource.data.over == true && request.resource.data.over == false)
            ||
            (resource.data.over == false && (
              // picture puzzle: either player may upload or change the picture (only `state` changes), even out of turn
              (resource.data.game == 'photo'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']))
              ||
              // turn games: only the player whose turn it is may change the room
              (resource.data.game in ['ttt', 'memory', 'photo']
                && request.auth.uid == resource.data.players[resource.data.turn].uid)
              ||
              // race games: you may only change your own progress, or finish the game as the winner
              (resource.data.game in ['sudoku', 'slide']
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['prog' + mySeat(resource.data), 'over', 'winner', 'score'])
                && (request.resource.data.over == false || request.resource.data.winner == mySeat(resource.data)))
            ))
          )
        )
      );

      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
    }

    // One record per finished game, used for each player's history.
    match /games/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids;
    }
  }
}
